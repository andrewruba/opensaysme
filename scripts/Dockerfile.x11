FROM node:22-bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
      xvfb xauth openbox x11-utils xdotool xsel python3 libx11-6 alsa-utils \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace
COPY package.json package-lock.json ./
RUN npm ci && chown -R node:node /workspace
COPY tsconfig.json tsconfig.build.json ./
COPY src ./src
COPY tests ./tests
COPY native/linux ./native/linux

ENV OPENSAYSME_X11_TEST=1 XDG_SESSION_TYPE=x11
USER node
# Run with docker --init: xvfb-run relies on normal Unix signal handling.
CMD ["xvfb-run", "-a", "npx", "vitest", "run", "tests/linux-live.test.ts"]
