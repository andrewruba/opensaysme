{
  "name": "opensaysme",
  "version": "0.4.0",
  "private": true,
  "description": "Reduce friction in AI-agent interactions with voice and desktop context.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "opensaysme": "bin/opensaysme.mjs",
    "osm": "bin/opensaysme.mjs"
  },
  "engines": {
    "node": ">=26.13.0"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "build:native": "node scripts/build-native.mjs",
    "install:cli": "npm run build && npm run build:native && npm link --offline --no-audit --no-fund",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check:version": "node scripts/check-version.mjs",
    "check": "npm run check:version && npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "commander": "^15.0.0",
    "sharp": "^0.35.5",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "@typescript/native": "npm:typescript@~7.0.2",
    "eslint": "^10.13.0",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
